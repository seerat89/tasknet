{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "crons": [
    { "path": "/cron/cleanup", "schedule": "0 2 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
