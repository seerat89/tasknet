APP_NAME=TaskNet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker (recommended): the app reaches the "postgres" service from compose.yaml.
# The password below is for local development only.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tasknet
DB_USERNAME=tasknet_app
DB_PASSWORD=tasknet_dev_password
# On Vercel the Neon integration sets DB_DATABASE_URL (the pooled URL); it is used when DB_URL is not set.
# Use Neon's unpooled URL only for migrations and admin tasks, never for normal application traffic.

MCP_REDIRECT_DOMAINS=http://localhost,http://127.0.0.1
MCP_RATE_LIMIT=120

# Shown on the privacy page; supply at deployment (all optional).
TASKNET_PRIVACY_CONTACT=
TASKNET_OPERATOR_NAME=
TASKNET_HOSTING_PROVIDER=
TASKNET_DATABASE_PROVIDER=

# Production only: Vercel Cron sends this as a bearer token to /cron/cleanup. Leave it unset locally.
# CRON_SECRET=

# OAuth signing keys for MCP clients. Locally they are generated into storage/ (git-ignored).
# On Vercel, set the full PEM contents instead:
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime updates through Laravel Reverb (the "reverb" service in compose.yaml).
# These are local development placeholders, not secrets. Use new values in production.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tasknet-local
REVERB_APP_KEY=tasknet-local-key
REVERB_APP_SECRET=tasknet-local-secret
# Where the Laravel containers reach Reverb inside Docker:
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Where the browser reaches Reverb (published Docker port). The browser reads these when a page is
# rendered, so they are not baked into the JavaScript build. In production leave them unset: the
# browser then connects to the site's own address (wss://<site>).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
